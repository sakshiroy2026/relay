# Copy to .env on the server and fill in. NEVER commit .env.
# ── required ──────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require   # Neon connection string
DEV_TENANT_ID=                     # printed by: python -m scripts.seed
RELAY_DOMAIN=                      # e.g. relay-sakshi.duckdns.org (Caddy gets the HTTPS certificate)
LEASE_SECONDS=90                   # keep well above LLM_TIMEOUT_SECONDS (60)
# ── the public demo (free: the scripted fake model) ───────
PUBLIC_DEMO_KEY=                   # a key of a DEMO-mode tenant; the page offers it to visitors
# ── optional: real runs for your own live tenant ──────────
ANTHROPIC_API_KEY=                 # leave empty to keep the server at $0
TAVILY_API_KEY=                    # free tier; real web_search for live runs
